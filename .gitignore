secrets.h
.vscode/
.pio/
data/
*.pyc

# camera captures / calibration dumps from on-unit sessions — keep locally only
*.jpg
*.rgb
blx-results.txt
wb-results.txt
blx-*.txt
wb-*.txt

# poller runtime log (llama_usage_poller.py appends to it beside the repo)
poller.log
usage.jsonl

# DSH client preset bundles the GUI drops into the working dir (not project files)
*.dshpreset
.preset-dl/

# local working notes / handoff scratch (not project files)
.scratch/

# BLE/USB-bridge one-off spikes (validated R1 in PLAN, not part of the built firmware)
spike/
spike_hid_src/

# host test build artifacts (tools/configtest, tools/qrtest, tools/provformtest)
tools/configtest/*.exe
tools/qrtest/*.exe
tools/provformtest/*.exe

# ESP-IDF generated sdkconfig (per-env, regenerated from sdkconfig.defaults)
sdkconfig.*
!sdkconfig.defaults

# The ESP-IDF project skeleton PlatformIO writes when these are absent
# (espidf.py: create_default_project_files() only writes them `if not os.path.isfile`).
# We do not customise them, so they are generated artifacts, not sources.
/CMakeLists.txt
/src/CMakeLists.txt
