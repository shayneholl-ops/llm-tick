#pragma once
// Central config. Copy to secrets.h (gitignored) and fill in your values:
//     cp secrets.h.example secrets.h
//
// WEATHER_API_KEY: create a free key at https://www.weatherapi.com
//   (no key / fetch fails -> the standby screen just shows "no weather").
// SERVER_HOST: mDNS name of the machine running server.py.
//   On Windows it is your computer name (hostname); on macOS: scutil --get LocalHostName
// SERVER_IP_OCTETS: static fallback, used only when mDNS gets no answer.

#define WIFI_SSID     "your-ssid"
#define WIFI_PASS     "your-password"

#define WEATHER_API_KEY  ""
#define WEATHER_LOCATION "Vancouver"
#define WEATHER_UNITS    "metric"

#define SERVER_HOST      "your-pc"
#define SERVER_IP_OCTETS 192, 168, 1, 100
#define SERVER_PORT      8266
