#pragma once
// Central config. Copy to secrets.h (gitignored) and fill in your values:
//     cp secrets.h.example secrets.h
//
// These are the FACTORY DEFAULTS: what a Board uses when it has nothing stored in
// NVS. Once the Provisioning feature has written runtime values, NVS wins and these
// are only the recovery path.
//
// WEATHER_API_KEY: create a free key at https://www.weatherapi.com
//   (no key / fetch fails -> the standby screen just shows "no weather").
// SERVER_HOST: mDNS name of the machine running server.py.
//   On Windows it is your computer name (hostname); on macOS: scutil --get LocalHostName
// SERVER_IP: static fallback, used only when mDNS gets no answer. Written as four
//   octets so it can be both constructed as an IPAddress and shown as text.

#define WIFI_SSID     "your-ssid"
#define WIFI_PASS     "your-password"

#define WEATHER_API_KEY  ""
#define WEATHER_LOCATION "Vancouver"
#define WEATHER_UNITS    "metric"

#define SERVER_HOST      "your-pc"
#define SERVER_IP_A      192
#define SERVER_IP_B      168
#define SERVER_IP_C      1
#define SERVER_IP_D      100
#define SERVER_PORT      8266

// Convenience forms derived from the four octets above. Keep these as they are;
// the firmware and the Config seam both read the octets, not these.
#define SERVER_IP_OCTETS SERVER_IP_A, SERVER_IP_B, SERVER_IP_C, SERVER_IP_D
#define SERVER_IP_TEXT   CFG_STR(SERVER_IP_A) "." CFG_STR(SERVER_IP_B) "." \
                         CFG_STR(SERVER_IP_C) "." CFG_STR(SERVER_IP_D)
